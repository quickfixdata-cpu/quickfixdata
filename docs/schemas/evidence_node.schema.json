{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/evidence_node.schema.json",
  "title": "evidence_node",
  "description": "Single evidence artifact node.",
  "type": "object",
  "required": ["id","producer_engine","schema_id","checksum","timestamp"],
  "properties": {
    "id": {"type":"string"},
    "producer_engine": {"type":"string"},
    "schema_id": {"type":"string"},
    "checksum": {"type":"string"},
    "timestamp": {"type":"string","format":"date-time"},
    "provenance": {"type":"object"},
    "payload": {"type":"object"}
  },
  "additionalProperties": false
}