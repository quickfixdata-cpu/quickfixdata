{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/validation_report.schema.json",
  "title": "validation_report",
  "description": "Global validation report produced by Global Validation Engine.",
  "type": "object",
  "required": ["id","execution_id","violations","created_at"],
  "properties": {
    "id": {"type":"string"},
    "execution_id": {"type":"string"},
    "violations": {"type":"array","items":{"type":"object"}},
    "missing_evidence": {"type":"array","items":{"type":"string"}},
    "created_at": {"type":"string","format":"date-time"}
  },
  "additionalProperties": false
}