{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/runtime_contract.schema.json",
  "title": "runtime_contract",
  "description": "Runtime contract template for engines.",
  "type": "object",
  "required": ["id","version","owner_role","inputs_schema_id","outputs_schema_id"],
  "properties": {
    "id": {"type":"string"},
    "version": {"type":"string"},
    "owner_role": {"type":"string"},
    "inputs_schema_id": {"type":"string"},
    "outputs_schema_id": {"type":"string"},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "timeout_seconds": {"type":"integer"},
    "retry_policy": {"type":"object"},
    "failure_modes": {"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": false
}